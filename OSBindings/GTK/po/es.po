#: MachineWindow.cpp:144
msgid ""
"Open a disk, tape, cartridge or snapshot, or drop one here.\n"
"The emulator will select and configure a machine for you."
msgstr ""
"Abre un disco, cinta, cartucho o instantánea, o arrástralo aquí.\n"
"El emulador elegirá y configurará una máquina por ti."

#: MachineWindow.cpp:157
msgid "ROMs Needed"
msgstr "Se necesitan ROMs"

#: MachineWindow.cpp:167
msgid "_Choose ROM Files…"
msgstr "_Elegir archivos de ROM…"

#: MachineWindow.cpp:284
msgid "Provide ROMs"
msgstr "Proporciona las ROMs"

#: MachineWindow.cpp:331
msgid "Only local files can be opened."
msgstr "Solo se pueden abrir archivos locales."

#: MachineWindow.cpp:355
#, c-format
msgid "Clock Signal doesn't recognise “%s”."
msgstr "Clock Signal no reconoce «%s»."

#: MachineWindow.cpp:379
msgid "This machine couldn't be started."
msgstr "No se pudo iniciar esta máquina."

#: MachineWindow.cpp:403
msgid "No audio output is available."
msgstr "No hay salida de audio disponible."

#: MachineWindow.cpp:453
msgid "Insert"
msgstr "Insertar"

#: MachineWindow.cpp:453
