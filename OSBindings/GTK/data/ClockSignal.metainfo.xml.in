<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@CLK_GTK_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Clock Signal</name>
  <summary>Emulate 8- and 16-bit computers and consoles</summary>
  <developer id="io.github.tomharte">
    <name>Thomas Harte</name>
  </developer>
  <description>
    <p>Clock Signal is a latency-hating emulator of 8- and 16-bit platforms, with single-click loading
    of any piece of source media and a heavy signal processing tilt for accurate reproduction of original outputs.</p>
    <p>This is an unofficial GTK4/libadwaita frontend for Linux.</p>
  </description>
  <launchable type="desktop-id">@CLK_GTK_APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/TomHarte/CLK</url>
  <url type="bugtracker">https://github.com/goliv04053/CLK/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="2026-11-21"/>
  </releases>
</component>
